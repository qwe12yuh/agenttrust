# Private key of your BSC deployment wallet (with ~0.01 BNB for deployment gas)
# NEVER commit your real .env file!
DEPLOYER_PRIVATE_KEY=

# Optional custom RPC
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# BscScan / Etherscan v2 API key for open-source verification
BSCSCAN_API_KEY=

# Defaults to 0x60b9262456de011f7d15a54cdd8c48baaa8b022f on BSC Mainnet (chainId 56)
AGENT_ID_REGISTRY=
